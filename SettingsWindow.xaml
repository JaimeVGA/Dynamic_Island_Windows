<Window x:Class="DynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island - Configuración" Icon="Assets/app.ico"
        Width="560" Height="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#18181B"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="#FAFAFA">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1.5"
                                CornerRadius="10" Padding="14,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#303034"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1.5"
                                CornerRadius="16" Padding="14,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#303034"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter TargetName="bd" Property="Background" Value="#1E3A5F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,24">
            <TextBlock Text="Configuración" FontSize="24" FontWeight="SemiBold"/>

            <TextBlock Text="MODO AUTOMÁTICO" Style="{StaticResource Section}"/>
            <CheckBox x:Name="AutoBox" Content="Cambiar de modo según la reproducción y ventanas"/>
            <TextBlock Text="Prioridad: app maximizada o acoplada, luego música, luego escritorio." Foreground="#71717A" FontSize="12" Margin="0,0,0,6"/>
            <StackPanel x:Name="AutoPanel"/>

            <TextBlock Text="MODO" Style="{StaticResource Section}"/>
            <StackPanel x:Name="ManualPanel">
            <RadioButton x:Name="ModeClassic" GroupName="mode">
                <StackPanel>
                    <TextBlock Text="Clásico" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Píldora compacta con la hora. Se expande al pasar el mouse."
                               Foreground="#A1A1AA" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ModeBar" GroupName="mode">
                <StackPanel>
                    <TextBlock Text="Barra delgada" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Solo una línea fina arriba. Se hace grande al pasar el mouse."
                               Foreground="#A1A1AA" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ModeWide" GroupName="mode">
                <StackPanel>
                    <TextBlock Text="Barra ancha" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Barra grande con la carátula, el título y la hora siempre visibles."
                               Foreground="#A1A1AA" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </RadioButton>
            </StackPanel>

            <TextBlock Text="TEMA" Style="{StaticResource Section}"/>
            <WrapPanel x:Name="ThemePanel"/>

            <TextBlock Text="CUOTA DE IA (TOKENS)" Style="{StaticResource Section}"/>
            <CheckBox x:Name="ShowAiBox" Content="Mostrar tokens restantes en la isla"/>
            <StackPanel x:Name="AiPanel" Margin="0,4,0,0">
                <TextBlock Text="Servicio de IA" Foreground="#A1A1AA" FontSize="12" Margin="0,4,0,6"/>
                <WrapPanel x:Name="AiProviderPanel" Margin="0,0,0,8"/>
                <TextBlock x:Name="AiHintText" Foreground="#71717A" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <TextBlock Text="API Key (opcional, cifrada localmente)" Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,4"/>
                <PasswordBox x:Name="AiKeyBox" Background="#27272A" Foreground="#FAFAFA" BorderBrush="#3F3F46"
                             BorderThickness="1" Padding="8,6" Margin="0,0,0,8"/>

                <StackPanel x:Name="AiEndpointPanel" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock Text="Endpoint JSON personalizado" Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="AiEndpointBox" Background="#27272A" Foreground="#FAFAFA" BorderBrush="#3F3F46"
                             BorderThickness="1" Padding="8,6"/>
                </StackPanel>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Límite manual (tokens, opcional)" Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="AiLimitBox" Background="#27272A" Foreground="#FAFAFA" BorderBrush="#3F3F46"
                                 BorderThickness="1" Padding="8,6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tokens usados (manual)" Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="AiUsedBox" Background="#27272A" Foreground="#FAFAFA" BorderBrush="#3F3F46"
                                 BorderThickness="1" Padding="8,6"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,10">
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Nivel manual rápido (%)" Foreground="#A1A1AA" FontSize="12"/>
                        <TextBlock x:Name="AiSliderLabel" Text="100%" Foreground="#FAFAFA" FontSize="12"
                                   FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="AiPercentSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AiSaveTestBtn" Content="Guardar y actualizar" Background="#2563EB" Foreground="#FFFFFF"
                            BorderThickness="0" Padding="14,7" Cursor="Hand" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AiResultText" Foreground="#A1A1AA" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="310"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="RELOJ" Style="{StaticResource Section}"/>
            <CheckBox x:Name="Use24HourBox" Content="Usar formato de 24 horas"/>

            <TextBlock Text="SISTEMA" Style="{StaticResource Section}"/>
            <CheckBox x:Name="StartupBox" Content="Iniciar con Windows"/>
        </StackPanel>
    </ScrollViewer>
</Window>
