<Window x:Class="DynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island - Configuración" Icon="Assets/app.ico"
        Width="560" Height="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#18181B"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="#FAFAFA">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1.5"
                                CornerRadius="10" Padding="14,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#303034"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1.5"
                                CornerRadius="16" Padding="14,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#303034"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter TargetName="bd" Property="Background" Value="#1E3A5F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FAFAFA"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,24">
            <TextBlock Text="Configuración" FontSize="24" FontWeight="SemiBold"/>

            <TextBlock Text="MODO AUTOMÁTICO" Style="{StaticResource Section}"/>
            <CheckBox x:Name="AutoBox" Content="Cambiar de modo según la reproducción"/>
            <TextBlock Text="Prioridad: app maximizada, luego música, luego escritorio." Foreground="#71717A" FontSize="12" Margin="0,0,0,6"/>
            <StackPanel x:Name="AutoPanel"/>

            <TextBlock Text="MODO" Style="{StaticResource Section}"/>
            <StackPanel x:Name="ManualPanel">
            <RadioButton x:Name="ModeClassic" GroupName="mode">
                <StackPanel>
                    <TextBlock Text="Clásico" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Píldora compacta con la hora. Se expande al pasar el mouse."
                               Foreground="#A1A1AA" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ModeBar" GroupName="mode">
                <StackPanel>
                    <TextBlock Text="Barra delgada" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Solo una línea fina arriba. Se hace grande al pasar el mouse."
                               Foreground="#A1A1AA" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ModeWide" GroupName="mode">
                <StackPanel>
                    <TextBlock Text="Barra ancha" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Barra grande con la carátula, el título y la hora siempre visibles."
                               Foreground="#A1A1AA" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </RadioButton>
            </StackPanel>

            <TextBlock Text="TEMA" Style="{StaticResource Section}"/>
            <WrapPanel x:Name="ThemePanel"/>

            <TextBlock Text="RELOJ" Style="{StaticResource Section}"/>
            <CheckBox x:Name="Use24HourBox" Content="Usar formato de 24 horas"/>

            <TextBlock Text="SISTEMA" Style="{StaticResource Section}"/>
            <CheckBox x:Name="StartupBox" Content="Iniciar con Windows"/>
        </StackPanel>
    </ScrollViewer>
</Window>
